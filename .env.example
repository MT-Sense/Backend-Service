# Copy to .env and adjust. .env is gitignored.

PORT=8080

# Either DATABASE_URL, or the DB_* parts below.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/mtsense?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mtsense
DB_SSLMODE=disable

# REQUIRED. Minimum 32 characters — the server refuses to start without it rather than
# falling back to a default key. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Token lifetimes, in minutes.
ACCESS_TOKEN_TTL=15
REFRESH_TOKEN_TTL=10080

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Seed demo data on boot when the database is empty. Set to false in production.
SEED_ON_BOOT=true

# FastAPI AI service. Survey submissions with comments need this service running.
AI_SERVICE_URL=http://127.0.0.1:8000

# Must match AI-Service/.env; used only for the restricted model training endpoint.
# Generate a random value, e.g. with: openssl rand -hex 32
AI_TRAINING_TOKEN=
